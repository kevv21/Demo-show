{
  "$description": "Tokens de diseño de Quincena (formato W3C DTCG). Importables en Figma con Tokens Studio o con un plugin de importación de variables. Son los mismos valores que src/styles.css.",
  "claro": {
    "bg": {
      "base": { "$type": "color", "$value": "#F4F5F0" },
      "surface": { "$type": "color", "$value": "#FFFFFF" },
      "sunken": { "$type": "color", "$value": "#ECEEE7" },
      "hero": { "$type": "color", "$value": "#13201A" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "#13201A" },
      "muted": { "$type": "color", "$value": "#5F6A64" },
      "on-hero": { "$type": "color", "$value": "#FFFFFF" },
      "accent": { "$type": "color", "$value": "#C6F36B" }
    },
    "border": { "default": { "$type": "color", "$value": "#E1E4DC" } },
    "brand": {
      "primary": { "$type": "color", "$value": "#1D6A50" },
      "on-primary": { "$type": "color", "$value": "#FFFFFF" },
      "soft": { "$type": "color", "$value": "#E1EFE8" }
    },
    "status": {
      "ok": { "$type": "color", "$value": "#1F8A5B" },
      "warn": { "$type": "color", "$value": "#B86E0B" },
      "warn-soft": { "$type": "color", "$value": "#FBEFD9" },
      "danger": { "$type": "color", "$value": "#C0392B" },
      "danger-soft": { "$type": "color", "$value": "#FBE4E0" },
      "info-soft": { "$type": "color", "$value": "#E6EEFB" }
    }
  },
  "oscuro": {
    "bg": {
      "base": { "$type": "color", "$value": "#0E1512" },
      "surface": { "$type": "color", "$value": "#16201B" },
      "sunken": { "$type": "color", "$value": "#1D2923" },
      "hero": { "$type": "color", "$value": "#1C2B23" }
    },
    "text": {
      "primary": { "$type": "color", "$value": "#EEF2EC" },
      "muted": { "$type": "color", "$value": "#9AA59F" },
      "on-hero": { "$type": "color", "$value": "#FFFFFF" },
      "accent": { "$type": "color", "$value": "#C6F36B" }
    },
    "border": { "default": { "$type": "color", "$value": "#26332C" } },
    "brand": {
      "primary": { "$type": "color", "$value": "#5CC79A" },
      "on-primary": { "$type": "color", "$value": "#0E1512" },
      "soft": { "$type": "color", "$value": "#1B3328" }
    },
    "status": {
      "ok": { "$type": "color", "$value": "#5CC79A" },
      "warn": { "$type": "color", "$value": "#E7A83E" },
      "warn-soft": { "$type": "color", "$value": "#33270F" },
      "danger": { "$type": "color", "$value": "#F07A6C" },
      "danger-soft": { "$type": "color", "$value": "#3A1C18" },
      "info-soft": { "$type": "color", "$value": "#18243A" }
    }
  },
  "categoria": {
    "vivienda": { "$type": "color", "$value": "#5B6CF0" },
    "servicios": { "$type": "color", "$value": "#2E9BC6" },
    "super": { "$type": "color", "$value": "#1F8A5B" },
    "transporte": { "$type": "color", "$value": "#E08A1E" },
    "salud": { "$type": "color", "$value": "#D6478F" },
    "deudas": { "$type": "color", "$value": "#C0392B" },
    "comida": { "$type": "color", "$value": "#E0565B" },
    "ocio": { "$type": "color", "$value": "#A35BD6" },
    "suscripciones": { "$type": "color", "$value": "#7A6FF0" },
    "hormiga": { "$type": "color", "$value": "#8A7A55" },
    "personal": { "$type": "color", "$value": "#C08A2E" },
    "metas": { "$type": "color", "$value": "#13201A" },
    "otros": { "$type": "color", "$value": "#5F6A64" }
  },
  "radio": {
    "tarjeta": { "$type": "dimension", "$value": "20px" },
    "hero": { "$type": "dimension", "$value": "24px" },
    "control": { "$type": "dimension", "$value": "12px" },
    "boton": { "$type": "dimension", "$value": "14px" },
    "pildora": { "$type": "dimension", "$value": "999px" }
  },
  "espacio": {
    "xs": { "$type": "dimension", "$value": "4px" },
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "12px" },
    "lg": { "$type": "dimension", "$value": "16px" },
    "xl": { "$type": "dimension", "$value": "20px" },
    "gutter": { "$type": "dimension", "$value": "16px" }
  },
  "tipografia": {
    "familia": { "$type": "fontFamily", "$value": "Manrope" },
    "monto-hero": { "$type": "typography", "$value": { "fontFamily": "Manrope", "fontWeight": 800, "fontSize": "48px", "lineHeight": 1.05, "letterSpacing": "-0.03em" } },
    "titulo": { "$type": "typography", "$value": { "fontFamily": "Manrope", "fontWeight": 800, "fontSize": "26px", "lineHeight": 1.2, "letterSpacing": "-0.02em" } },
    "titulo-tarjeta": { "$type": "typography", "$value": { "fontFamily": "Manrope", "fontWeight": 800, "fontSize": "17px", "lineHeight": 1.3, "letterSpacing": "-0.01em" } },
    "cuerpo": { "$type": "typography", "$value": { "fontFamily": "Manrope", "fontWeight": 500, "fontSize": "16px", "lineHeight": 1.4 } },
    "secundario": { "$type": "typography", "$value": { "fontFamily": "Manrope", "fontWeight": 500, "fontSize": "13px", "lineHeight": 1.4 } },
    "etiqueta": { "$type": "typography", "$value": { "fontFamily": "Manrope", "fontWeight": 600, "fontSize": "11px", "lineHeight": 1.2 } }
  }
}
